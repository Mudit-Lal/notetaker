# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ALLOWED_USER_IDS=your-telegram-user-id  # Get from @userinfobot. Comma-separated for multiple users.

# OpenAI (Whisper transcription)
OPENAI_API_KEY=your-openai-api-key

# Anthropic (Claude for summarization, tagging, linking)
ANTHROPIC_API_KEY=your-anthropic-api-key

# API Authentication
API_SECRET_KEY=generate-a-strong-secret-key
API_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Calendar (optional)
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CREDENTIALS_FILE=credentials.json

# Database
DATABASE_PATH=data/notetaker.db

# Server
API_HOST=0.0.0.0
API_PORT=8000
